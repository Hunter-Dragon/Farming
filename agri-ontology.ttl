@prefix : <http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2/> .

<http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#attackedBy
:attackedBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain :Crop ;
            rdfs:range :Pest .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#hasGrowthStage
:hasGrowthStage rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :Crop ;
                rdfs:range :GrowthStage .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#plantedInSeason
:plantedInSeason rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf owl:topObjectProperty ;
                 rdfs:domain :Crop ;
                 rdfs:range :Season .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#requiresSoil
:requiresSoil rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Crop ;
              rdfs:range :SoilType .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#susceptibleTo
:susceptibleTo rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Crop ;
               rdfs:range :Disease .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#treatedWith
:treatedWith rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :Disease ;
             rdfs:range :FertilizerType .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#durationDays
:durationDays rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :GrowthStage ;
              rdfs:range xsd:integer .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#harvestYield
:harvestYield rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :ClimateCondition ;
              rdfs:range xsd:float .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#optimalTemperature
:optimalTemperature rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :Crop ;
                    rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#ClimateCondition
:ClimateCondition rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#Crop
:Crop rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#Disease
:Disease rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#FertilizerType
:FertilizerType rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#FruitVegetable
:FruitVegetable rdf:type owl:Class ;
                rdfs:subClassOf :Crop .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#GrowthStage
:GrowthStage rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#LeafyVegetable
:LeafyVegetable rdf:type owl:Class ;
                rdfs:subClassOf :Crop .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#Pest
:Pest rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#RootVegetable
:RootVegetable rdf:type owl:Class ;
               rdfs:subClassOf :Crop .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#Season
:Season rdf:type owl:Class .


###  http://www.semanticweb.org/admin/ontologies/2026/7/untitled-ontology-2#SoilType
:SoilType rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ClimateCondition
                :Crop
                :Disease
                :FertilizerType
                :GrowthStage
                :Pest
                :Season
                :SoilType
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :FruitVegetable
                :LeafyVegetable
                :RootVegetable
              )
] .


